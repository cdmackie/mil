;-----------------------------
scas_p (scas_aD)
WORD
{
PUSH BX
movements(scas_aD)
IF (NC)
   POP BX
   RETURN
ENDIF
BX = AX
IF (movsrepD <> 0)
   removewhitespace(BX)
   BX = AX
   BX++
   removewhitespace(BX)
   BX = AX
   ; should point to Z or NZ
   AL = BX.0
   IF ((AL = 'N' && BX.1 = 'Z') || (AL = 'Z' && BX.1 = 0))
      movscond = AL
      STC
   ELSE
      error_code = MUSTSPECIFYZORNZ_ER
      CLC
   ENDIF
ENDIF
DO
   EXITL (NC)
   IF (movslen = 0)
      error_code = MUSTSPECIFYBORW_ER
      CLC
      EXITL
   ENDIF
   IF (movsdirD <> 0)
      writeobject1(movsdirD,1)
   ENDIF
   IF (movsrepD <> 0)
      writeobject1(movsrepD,0)
      IF (movscond = 0)
         CLC
         EXIT
      ENDIF
      writechar(movscond,0)
      IF (movscond = 'N')
         writechar('Z',0)
      ENDIF
      writechar(' ',0)
   ENDIF
   writeobject1(&scas_t,0)
   writechar(movslen,1)
   STC
END
AX = BX
POP BX
}
;-----------------------------
movements (movD)
WORD
{
PUSH BX
PUSH CX
BX = movD
removewhitespace(BX)
BX = AX
movslen = 0
movsdirD = 0
movsrepD = 0
movscond = 0
CL = 0
DO
   AL = BX.0
   IF (AL = 0 || AL = COMMA)
      STC
      EXIT
   ENDIF
   BX++
   IF (CL = 0 && (AL = 'W' || AL = 'B' || AL = 'D'))
      movslen = AL
      INC CL
      CONTINUE
   ENDIF
   IF (CL <> 0 && (AL = 'I' || AL = 'D'))
      IF (AL = 'I')
         AX = &cld_t
      ELSE
         AX = &std_t
      ENDIF
      movsdirD = AX
      INC CL
      CONTINUE
   ENDIF
   IF (CL <> 0 && AL = 'R')
      AX = &rep_t
      movsrepD = AX
      INC CL
      CONTINUE
   ENDIF
   error_code = INVALIDSTRINGOPERATION_ER
   CLC
END
AX = BX
POP CX
POP BX
}
;-----------------------------
save_p (save_aD)
WORD save_aD
{
PUSH BX
PUSH CX
PUSH DI
PUSH SI
BX = save_aD
DO
   IF (save_on = 1)
      error_code = CANNOTSAVEAGAIN_ER
      CLC
      EXIT
   ENDIF
   DI = &save_stack
   DI.0 = 0
   DI++
   CL = 0
   REPEAT
      removewhitespace (BX)
      BX = AX
      AL = BX.0
      IF (AL = ',')
         BX++
         CONTINUE
      ENDIF
      IF (AL = 0)
         save_on = 1
         DI = &save_stack
         DI.0 = CL
         STC
         EXIT
      ENDIF
      parseregister (BX)
      EXIT (NC)
      SI = AX
      writeobject2(&push_t,SI,1)
      DI.0.D = SI
      DI += 2
      BX += 2
      CL++
   ENDREP
   IF (NC)
      error_code = NOTREGISTER_ER
      CLC
   ENDIF
END
POP SI
POP DI
POP CX
POP BX
}
;------------------------
goto_p (goto_aD)
WORD goto_aD
{
PUSH BX
PUSH CX
PUSH DI
PUSH SI
BX = goto_aD
DO
   removewhitespace(BX)
   BX = AX
   IF (BX.0 = 0)
      error_code = NOLABEL_ER
      CLC
      EXIT
   ENDIF
   DI = &variable_string
   PUSH DI
   DI++
   strcpy(BX,DI)
   DI--
   DI.0 = AL
   POP DI
   writeobject2(&jmplong_t,DI,1)
   STC   
END
AX = BX
POP SI
POP DI
POP CX
POP BX
}
;------------------------
keep_p (keep_aD)
WORD keep_aD
{
PUSH BX
PUSH CX
PUSH DI
PUSH SI
BX = keep_aD
DO
   removewhitespace(BX)
   BX = AX
   IF (BX.0 = 0)
      ; clear the save on call
      keep = 0
      STC
      EXIT
   ENDIF
   ; otherwise parse the registers
   DI = &keep_list
   keep = 0
   REPEAT
      removewhitespace(BX)
      BX = AX
      AL = BX.0
      IF (AL = 0)
         STC
         EXIT
      ENDIF
      IF (AL = ',')
         BX++
         CONTINUE
      ENDIF
      parseregister(BX)
      IF (NC) ; invalid register
         AL = INVALIDREG_ER
         CLC
         EXIT
      ENDIF
      ; ax points to the REGISTER structure
      SI = AX
      IF (SI.2 = 'H' || SI.2 = 'L')
         AL = INVALIDREG_ER
         CLC
         EXIT
      ENDIF
      IF (keep = MAXKEEP)
         AL = TOOMANYREG_ER
         CLC
         EXIT
      ENDIF
      ; add register to keep list
      DI.0.D = SI
      DI += 2
      keep++
      BX += 2
   ENDREP
   IF (NC)
      error_code = AL
      keep = 0
      CLC
      EXIT
   ENDIF
   STC   
END
AX = BX
POP SI
POP DI
POP CX
POP BX
}
;------------------------
saveon_p (saveon_aD)
WORD saveon_aD
{
PUSH BX
PUSH CX
PUSH DI
PUSH SI
BX = saveon_aD
DO
   removewhitespace(BX)
   BX = AX
   IF (BX.0 = 0)
      ; clear the save on call
      saveon = 0
      STC
      EXIT
   ENDIF
   ; otherwise parse the registers
   DI = &saveon_list
   saveon = 0
   REPEAT
      removewhitespace(BX)
      BX = AX
      AL = BX.0
      IF (AL = 0)
         STC
         EXIT
      ENDIF
      IF (AL = ',')
         BX++
         CONTINUE
      ENDIF
      parseregister(BX)
      IF (NC) ; invalid register
         AL = INVALIDREG_ER
         CLC
         EXIT
      ENDIF
      ; ax points to the REGISTER structure
      SI = AX
      IF (SI.2 = 'H' || SI.2 = 'L')
         AL = INVALIDREG_ER
         CLC
         EXIT
      ENDIF
      IF (saveon = MAXKEEP)
         AL = TOOMANYREG_ER
         CLC
         EXIT
      ENDIF
      ; add register to keep list
      DI.0.D = SI
      DI += 2
      saveon++
      BX += 2
   ENDREP
   IF (NC)
      error_code = AL
      saveon = 0
      CLC
      EXIT
   ENDIF
   STC   
END
AX = BX
POP SI
POP DI
POP CX
POP BX
}
;------------------------
module_p (module_aD)
WORD
{
PUSH BX
PUSH CX
PUSH SI
PUSH DI
DO
   IF (moduletype <> 0)
      ; already defined
      error_code = MODULEDEFINED_ER
      CLC
      EXITL
   ENDIF
   BX = module_aD
   removewhitespace(BX)
   BX = AX
   IF (BX.0 <> '(')
      error_code = INVALIDMODULE_ER
      CLC
      EXITL
   ENDIF
   BX++
   removewhitespace(BX)
   BX = AX
   DI = &variable_string
   PUSH DI
   REPEAT
      AL = BX.0
      iswhite()
      EXIT (C)
      EXIT (AL = 0 | AL = ')')
      BX++
      uppercase()
      DI.0 = AL
      DI++
   ENDREP
   DI.0 = 0
   POP DI
   SI = &modules
   REPEAT
      IF (SI.0 = 0)
         CLC
         EXIT
      ENDIF
      SI += 2
      strcmp(DI,SI)
      EXIT (C)
      SI--
      AL = SI.0
      AH = 0
      AL += 2
      SI += AX
   ENDREP
   IF (NC)
      error_code = INVALIDMODULE_ER
      CLC
      EXIT
   ENDIF
   SI -= 2
   moduletype = SI.0
   STC
   AX = BX
END
POP DI
POP SI
POP CX
POP BX
}
