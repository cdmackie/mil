; MMACROS (converted successfully)

EXTERNAL BYTE assignments

EXTERNAL FAR writechar (BYTE,BYTE)
EXTERNAL FAR writeobject1 (WORD,BYTE)
EXTERNAL FAR writeobject2 (WORD,WORD,BYTE)
EXTERNAL FAR removewhitespace (WORD)
EXTERNAL FAR parsesourceline (WORD)
EXTERNAL FAR translatesource (WORD,WORD,WORD)
EXTERNAL FAR dealocall (WORD)
EXTERNAL FAR dstrcpy (WORD,WORD,BYTE)
EXTERNAL FAR d2strcpy (WORD,WORD,BYTE,BYTE)
EXTERNAL FAR d3strcpy (WORD,WORD,BYTE,BYTE,BYTE)
EXTERNAL FAR writenumber (WORD,BYTE)
EXTERNAL FAR storeglobal (WORD)
EXTERNAL FAR storelocal (WORD)
EXTERNAL FAR translate_structmem (WORD,BYTE)
EXTERNAL FAR numasc (WORD,WORD)
EXTERNAL FAR aloc (WORD)
EXTERNAL FAR parseassign (WORD,BYTE)
EXTERNAL FAR end_segment (BYTE)
EXTERNAL FAR end_segment_win (BYTE)
EXTERNAL FAR create_segment (BYTE,WORD)
EXTERNAL FAR create_segment_win (BYTE,WORD)
EXTERNAL FAR storeprocdef ()
EXTERNAL FAR strcpy (WORD,WORD)
EXTERNAL FAR loadupincludefile ()
EXTERNAL FAR readsourceline ()
EXTERNAL FAR copy_source_to_object (BYTE)
EXTERNAL FAR parseregister (WORD)
EXTERNAL FAR strcmp (WORD,WORD)
