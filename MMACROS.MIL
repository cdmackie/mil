DO
   EXIT (NC)
   IF (movslen = 0)
      error_code = MUSTSPECIFYBORW_ER
      CLC
      EXIT
   ENDIF
   IF (movsdirD <> 0)
      writeobject1(movsdirD,1)
   ENDIF
   IF (movsrepD <> 0)
      writeobject1(movsrepD,0)
      writechar(' ',0)
   ENDIF
   writeobject1(&stos_t,0)
   writechar(movslen,1)
