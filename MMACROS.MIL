EXTERNAL FAR pops_after (BYTE)
EXTERNAL FAR uppercase ()
EXTERNAL FAR iswhite ()

INCLUDE mconst.mil
;------------------------
DECLARE (DATA)
INCLUDE mdatainc.mil

MESSAGE iflabel = 'if_000'
MESSAGE elselabel = 'el_000'
LIST ellabel = 6,'el_000',34 DUP (0) ; plus room for 'return (cond)'
MESSAGE filabel = 'fi_000'
MESSAGE tflabel = 'tl_000'
MESSAGE sclabel = 'sc_000'

WORD ifcountD
WORD tfcountD
WORD sccountD

BYTE iflong
BYTE elselong
LIST if_string (80)
BYTE negate
BYTE orflag
BYTE condexit

BYTE save_on

LIST save_stack (31)

WORD flags = OFFSET nequal  ; JNZ     Z
      DW OFFSET equal   ; JZ
      DW OFFSET abveq   ; JAE     C
      DW OFFSET below   ; JB
      DW OFFSET equal   ; JZ     NZ
      DW OFFSET nequal  ; JNZ
      DW OFFSET below   ; JB     NC
      DW OFFSET abveq   ; JAE

WORD comparisons = OFFSET equal   ; =
                DW OFFSET nequal
                DW OFFSET nequal  ; !=
                DW OFFSET equal
                DW OFFSET below   ; <
                DW OFFSET abveq
                DW OFFSET abv     ; >
                DW OFFSET beleq
                DW OFFSET beleq   ; <=
                DW OFFSET abv
                DW OFFSET abveq   ; >=
                DW OFFSET below

                DW OFFSET sbelow   ; #<
                DW OFFSET sabveq
                DW OFFSET sabv     ; #>
                DW OFFSET sbeleq
                DW OFFSET sbeleq   ; #<=
                DW OFFSET sabv
                DW OFFSET sabveq   ; #>=
                DW OFFSET sbelow

MESSAGE equal = 'JZ'
MESSAGE nequal = 'JNZ'
MESSAGE abv = 'JA'
MESSAGE beleq = 'JBE'
MESSAGE below = 'JB'
MESSAGE abveq = 'JAE'
MESSAGE sabv = 'JG'
MESSAGE sbeleq = 'JLE'
MESSAGE sbelow = 'JL'
MESSAGE sabveq = 'JGE'

BYTE indo
BYTE movslen
WORD movsdirD
WORD movsrepD
BYTE movscond

BYTE moduletype

LIST modules = MODULE_DOS,3,'DOS',0,MODULE_WINDOWS,7,'WINDOWS',0,0

MESSAGE firstlocid = 'L_000'
MESSAGE endlocid = 'L_999'
MESSAGE preendlocid = 'L_998'
MESSAGE adjustsp1 = '+1)/2'
MESSAGE adjustsp2 = '*2'

LIST newlocid (7)
LIST lastlocid (7)
LIST locval (30)

;------------------------
DECLARE (STACK)
;------------------------
DECLARE (CODE)
;------------------------
opencurly_p (opencurly_aD)
WORD
{
PUSH BX
DO
   BX = opencurly_aD
   removewhitespace(BX)
   BX = AX
   IFL (status = STATUS_PARSEPROC)
      withinproc += 1
      IF (winproc_flag = 1)
         IF (number_paras = 0 && localcount <> 0)
            writeobject1(&incbp_t,1)
            writeobject1(&pushbp_movbp_t,1)
         ENDIF
         writeobject1(&pushmovds_t,1)
      ENDIF
      IF (localcount <> 0)
         ; set the last local
         update_local(0) ; write L_999 = lastlocid + locval
         IF (winproc_flag = 0 && number_paras = 0)
            writeobject1(&pushbp_movbp_t,1)
         ENDIF
         writeobject2(&sub_t,&sp_t,0)
         writeobject1(&comma_t,0)
         writeobject1(&endlocid,1)
      ENDIF
      IF (winproc_flag = 1)
         writeobject1(&pushsidi,1)
      ELSE
         ; check for saveon
         pushes_before(1)
      ENDIF
      SI = statestackptrD
      SI.0 = status
      SI.1.D = 0FFFFH
      statestackptrD += 3
      STC
      EXIT
   ENDIF
   IF (status = STATUS_STRUCTDEF)
      status = STATUS_STRUCTMEM
      STC
      EXIT
   ENDIF
   error_code = NONEEDFOROPENCURLY_ER
   CLC
END
AX = BX
POP BX
}
;-----------------------------
closecurly_p (closecurly_aD)
WORD
{
PUSH BX
PUSH CX
PUSH SI
DO
   BX = closecurly_aD
   removewhitespace(BX)
   BX = AX
   IF (status = STATUS_STRUCTMEM)
      status = STATUS_START
      BX = &struct_string
      BX++
      translate_structmem(BX,1)
      ; return C / NC
      EXITL
   ENDIF
   IFL (status <> DECLARECODE)
      PUSH BX
      BX = &current_proc_name
      BX++
      SI = &variable_string
      SI++
      strcpy(BX,SI)
      SI--
      SI.0 = AL + 1
      SI += AX + 1
      SI.0 = 'X'
      SI.1 = 0
      writeobject1(&variable_string,0)
      writechar(':',1)
      SI = &save_stack
      CL = SI.0
      IF (save_on = 1 && CL <> 0)
         ; restore all saved registers
         CH = 0
         SI++
         AX = CX
         AX--
         SHL AX,1
         SI += AX
         DO
            EXIT (CL = 0)
            BX = SI.0.D
            SI -= 2
            writeobject2(&pop_t,BX,1)
            LOOP
         END
      ENDIF
      save_on = 0 ; SAVE <reg>
      ; check for savon
      IF (winproc_flag = 0)
         pops_after(1)
      ELSE
         writeobject1(&popdisi,1)
      ENDIF
      POP BX
      IF (localcount <> 0)
         BX = &localblkst
         dealocall(BX)
         local_blkD = 0
         local_posD = 0
         IF (winproc_flag = 0)
            writeobject1(&movsp_t,1)
         ENDIF
      ENDIF
      IF (winproc_flag = 1)
         IF (number_paras <> 0 || localcount <> 0)
            writeobject1(&leasp_t,1)
         ENDIF
         writeobject1(&winprocend,1)
      ENDIF
      IF (number_paras <> 0)
         writeobject1(&popbp_t,1)
         IF (winproc_flag <> 0)
            writeobject1(&decbp_t,1)
         ENDIF
         BX = &parasblkst
         dealocall(BX)
         paras_blkD = 0
         paras_posD = 0
      ELSE
         IF (localcount <> 0)
            writeobject1(&popbp_t,1)
            IF (winproc_flag = 1)
               writeobject1(&decbp_t,1)
            ENDIF
         ENDIF
      ENDIF
      localcount = 0
      winproc_flag = 0
      IF (main_proc = 1)
         main_proc += 1
      ELSE
         writeobject2(&ret_t,&ret_by,1)
      ENDIF
      writeobject2(&current_proc_name,&endp_t,1)
      withinproc -= 1
      SI = statestackptrD - 3
      IF (SI.1.D <> 0FFFFH)
         ; error - loops dont match
         error_code = BADLOOPCOUNT_ER
         AX = &statestack
         statestackptrD = AX
         CLC
      ELSE
         statestackptrD -= 3
         STC
      ENDIF
      PUSHF
      status = DECLARECODE
      POPF
      EXIT
   ENDIF
   error_code = NOOPENCURLY_ER
   CLC
END
AX = BX
POP SI
POP CX
POP BX
}
;-----------------------------
default_p (default_aD)
WORD
{
; process the DEFAULT word at address default_a
PUSH BX
AL = status
PUSH AX ; save status
status = STATUS_DEFAULT
BX = default_aD
removewhitespace(BX)
BX = AX
IF (BX.0 = '(')
   BX++
   parsesourceline(BX)
   IF (C)
      SI = AX
      translatesource(SI,BX,CX)
      BX = CX
      IF (C)
         IF (AL = DEFAULTHEX || AL = DEFAULTDEC || AL = DEFAULTBIN)
            default_number = AL
            STC
         ELSE
            IF (AL = DEFAULTBYTE || AL = DEFAULTWORD)
               default_data = AL
               STC
            ELSE
               CLC
            ENDIF
         ENDIF
      ENDIF
   ENDIF
ELSE
   CLC
ENDIF
POP AX
PUSHF
IF (NC)
   error_code = INVALIDDEFAULT_ER
ENDIF
status = AL
POPF
POP BX
}
;------------------------
hex_p (hex_aD)
WORD
{
IF (status = STATUS_DEFAULT)
   AL = DEFAULTHEX
   STC
ELSE
   CLC
ENDIF
}
;-----------------------------
decimal_p (decimal_aD)
WORD
{
IF (status = STATUS_DEFAULT)
   AL = DEFAULTDEC
   STC
ELSE
   CLC
ENDIF
}
;-----------------------------
bin_p (bin_aD)
WORD
{
IF (status = STATUS_DEFAULT)
   AL = DEFAULTBIN
   STC
ELSE
   CLC
ENDIF
}
;-----------------------------
byte_p (byte_aD)
WORD
{
PUSH BX
PUSH DI
DO
   AL = status
   IF (AL = STATUS_DEFAULT)
      AL = DEFAULTBYTE
      STC
      EXITL
   ENDIF
   IFL (AL = DECLAREDATA || AL = STATUS_EXTERNDEF || withinproc = 1)
      DO
         BX = byte_aD
         removewhitespace(BX)
         BX = AX
         DI = &variable_string
         PUSH DI
         DI++
         DI.0 = GLOBAL_BYTE
         DI += 2
         dstrcpy(BX,DI,' ')
         DI--
         DI.0 = AL
         BX += AX + 1
         POP DI
         AL += 4
         DI.0 = AL
         storeglobal(DI)
         EXITL (NC)
         DI += 2
         IF (status = STATUS_EXTERNDEF)
            writeobject2(&extrn_t,DI,0)
            writechar(':',0)
            writeobject1(&byte_t,1)
            AX = BX
         ELSE
            IF (makeallpublic = 1)
               writeobject2(&public_t,DI,1)
            ENDIF
            writeobject2(DI,&db_t,0)
            IF (BX.0 <> '=')
               ; could be zero or another variable
               ; eg. BYTE test1   OR   BYTE test1,test2
               removewhitespace(BX)
               ; do we scan for the next variable ?
               writeobject1(&zero_t,1)
               AX =  BX
               STC
               EXIT
            ENDIF
            BX += 2
            writenumber(BX,1)
         ENDIF
         STC
      END
      EXITL
   ENDIF
   IF (AL = STATUS_LOCAL)
      DO
         BX = byte_aD
         removewhitespace(BX)
         BX = AX
         DI = &variable_string
         ; 00 type (LOCAL_WORD | LOCAL_BYTE | LOCAL_LIST)
         ; 01 local id ('000' or '001' etc)
         ; 04 length of name
         ; 05 ASCIIZ name
         ;
         ; 00 Length of item
         ; 01 Type
         ; 02 Namlen
         ; 03 ASCIIZ name
         ; NN Local id ('000 or '001', etc) (3 bytes)
         ;
         PUSH DI
         DI++
         DI.0 = LOCAL_BYTE
         DI += 2
         dstrcpy(BX,DI,' ')
         DI--
         DI.0 = AL
         BX += AX + 1
         DI += AX + 2 ; after null
         CX = AX
         SI = &newlocid
         DI.0 = SI.3
         DI.1 = SI.4
         DI.2 = SI.5
         POP DI
         CL += 7 ; null+namelen+localid+length+type
         DI.0 = AL
         storelocal(DI)
         EXIT (NC)
         localcount++
         ; output 'newlocid = lastlocid + locval'
         update_local(LOCAL_BYTE)
         AX = BX
         STC
      END
      EXIT
   ENDIF
   IF (AL = STATUS_STRUCTMEM)
      translate_structmem(byte_aD,0)
      EXIT
   ENDIF
   CLC
END
POP DI
POP BX
}
;-----------------------------
word_p (word_aD)
WORD
{
PUSH BX
PUSH DI
DO
   AL = status
   IF (AL = STATUS_DEFAULT)
      AL = DEFAULTWORD
      STC
      EXITL
   ENDIF
   IFL (AL = DECLAREDATA || AL = STATUS_EXTERNDEF || withinproc = 1)
      DO
         BX = word_aD
         removewhitespace(BX)
         BX = AX
         DI = &variable_string
         PUSH DI
         DI++
         DI.0 = GLOBAL_WORD
         DI += 2
         dstrcpy(BX,DI,' ')
         DI--
         DI.0 = AL
         BX += AX + 1
         POP DI
         AL += 4
         DI.0 = AL
         storeglobal(DI)
         EXITL (NC)
         DI += 2
         IF (status = STATUS_EXTERNDEF)
            writeobject2(&extrn_t,DI,0)
            writechar(':',0)
            writeobject1(&word_t,1)
            AX = BX
         ELSEL
            IF (makeallpublic = 1)
               writeobject2(&public_t,DI,1)
            ENDIF
            writeobject2(DI,&dw_t,0)
            IF (BX.0 <> '=')
               writeobject1(&zero_t,1)
               AX =  BX
               STC
               EXIT
            ENDIF
            BX++
            removewhitespace(BX)
            BX = AX
            DO
               IF (BX.0 >= '0' && BX.0 <= '9')
                  writenumber(BX,1)
                  EXIT
               ENDIF
               IF (BX.0 = '&')
                  SI = &variable_string
                  SI++
                  AX = &offset_t
                  AX++
                  strcpy(AX,SI)
                  SI--
                  SI.0 = AL
                  writeobject1(SI,0)
                  BX++
                  removewhitespace(BX)
                  BX = AX
               ENDIF
               SI = &variable_string
               SI++
               strcpy(BX,SI)
               SI--
               SI.0 = AL
               writeobject1(SI,1)
            END
         ENDIF
         STC
      END
      EXITL
   ENDIF
   IFL (AL = STATUS_LOCAL)
      DO
         BX = word_aD
         removewhitespace(BX)
         BX = AX
         DI = &variable_string
         ; 00 type (LOCAL_WORD | LOCAL_BYTE | LOCAL_LIST)
         ; 01 id '000'
         ; 04 length of name
         ; 05 ASCIIZ name
         ;
         ; 00 Item length
         ; 01 Type
         ; 02 Namelen
         ; 03 ASCIIZ name
         ; NN  id '000'
         PUSH DI
         DI++
         DI.0 = LOCAL_WORD
         DI += 2
         dstrcpy(BX,DI,' ')
         DI--
         DI.0 = AL
         BX += AX + 1
         DI += AX + 2 
         CX = AX
         SI = &newlocid
         DI.0 = SI.3
         DI.1 = SI.4
         DI.2 = SI.5
         POP DI
         CL += 7
         DI.0 = CL
         storelocal(DI)
         EXIT (NC)
         localcount++
         ; output 'newlocid = lastlocid + locval'
         update_local(LOCAL_WORD)
         AX = BX
         STC
      END
      EXIT
   ENDIF
   IF (AL = STATUS_STRUCTMEM)
      translate_structmem(word_aD,1)
      EXIT
   ENDIF
   CLC
END
POP DI
POP BX
}
;-----------------------------
update_local (ltype)
BYTE
{
SAVE BX,SI,DI

; write new
IF (ltype = 0)
   ; end of locals
   writeobject2(&preendlocid,&equal_t,0)
   writechar(' ',0)
   writechar('(',0)
ELSE
   writeobject2(&newlocid,&equal_t,0)
   writechar(' ',0)
ENDIF
writeobject1(&lastlocid,0)
writechar('+',0)
BX = &locval
IF (ltype = 0)
   writeobject1(BX,0)
   writeobject1(&adjustsp1,1)
   writeobject2(&endlocid,&equal_t,0)
   writechar(' ',0)
   writeobject2(&preendlocid,&adjustsp2,1)
   RETURN
ENDIF
writeobject1(BX,1)
;
; update
SI = &newlocid
SI++
DI = &lastlocid
DI++
strcpy(SI,DI)
DI--
DI.0 = AL
SI--
AL = SI.0
AH = 0
SI += AX
DO
   IF (SI.0 = '9')
      SI.0 = '0'
      SI--
      CONTINUE
   ENDIF
   SI.0 += 1
END
SI = &locval
AL = ltype
IF (AL = LOCAL_LIST)
   DI = &number_string
   SI++
   strcpy(DI,SI)
   SI--
   SI.0 = AL
ELSE
   SI.0 = 1
   SI.1 = '2'
   SI.2 = 0
ENDIF

}
;------------------------
string_p (string_aD)
WORD
{
PUSH BX
PUSH DI
DO
   AL = status
   IFL (AL = DECLAREDATA || withinproc = 1)
      DO
         BX = string_aD
         removewhitespace(BX)
         BX = AX
         DI = &variable_string
         PUSH DI
         DI++
         DI.0 = GLOBAL_STRING
         DI += 2
         dstrcpy(BX,DI,' ')
         DI--
         DI.0 = AL
         BX += AX
         POP DI
         AL += 4
         DI.0 = AL
         storeglobal(DI)
         EXITL (NC)
         DI += 2
         IF (makeallpublic = 1)
            writeobject2(&public_t,DI,1)
         ENDIF
         writeobject2(DI,&dw_t,0)
         writeobject1(&dollarplus4_t,1)
         writeobject1(&db_t,0)
         removewhitespace(BX)
         BX = AX
         IF (BX.0 = '(')
            BX++
            writenumber(BX,0)
            PUSH AX
            writeobject1(&comma_t,0)
            writenumber(BX,1)
            writeobject1(&db_t,0)
            writenumber(BX,0)
            writeobject2(&plus1_t,&dupzero_t,1)
            POP AX
            BX = AX
            IF (BX.0 = ')')
               BX++
               AX = BX
               STC
            ELSE
               error_code = NOCLOSEBRACKET_ER
               CLC
            ENDIF
            EXITL
         ENDIF
         IFL (BX.0 = '=')
            ; di points to variable_string
            DI++
            BX++
            REPEAT
               EXIT (BX.0 = 0 || BX.0 = QUOTE)
               BX++
            ENDREP
            strcpy(BX,DI)
            DI--
            DI.0 = AL
            BX += AX - 1
            AL -= 2
            SI = &number_string
            SI.0 = 6
            numasc(SI,AX)
            writeobject2(SI,&comma_t,0)
            writeobject1(SI,1)
            writeobject2(&db_t,DI,0)
            writechar(',',0)
            writechar('0',1)
            IF (BX.0 = QUOTE)
               BX++
               AX = BX
               STC
            ELSE
               error_code = NOCLOSEQUOTE_ER
               CLC
            ENDIF
            EXIT
         ENDIF
         error_code = INVALIDSTRING_ER
         CLC
      END
   ELSE
      CLC
   ENDIF
END
POP DI
POP BX
}
;-----------------------------
message_p (message_aD)
WORD
{
PUSH BX
PUSH DI
DO
   AL = status
   IFL (AL = DECLAREDATA || withinproc = 1)
      DO
         BX = message_aD
         removewhitespace(BX)
         BX = AX
         DI = &variable_string
         PUSH DI
         DI++
         DI.0 = GLOBAL_MESSAGE
         DI += 2
         dstrcpy(BX,DI,' ')
         DI--
         DI.0 = AL
         BX += AX
         POP DI
         AL += 4
         DI.0 = AL
         storeglobal(DI)
         EXITL (NC)
         DI += 2
         IF (makeallpublic = 1)
            writeobject2(&public_t,DI,1)
         ENDIF
         writeobject2(DI,&db_t,0)
         removewhitespace(BX)
         BX = AX
         IF (BX.0 = '(')
            BX++
            writenumber(BX,0)
            PUSH AX
            writeobject1(&comma_t,0)
            writenumber(BX,0)
            writeobject2(&plus1_t,&dupzero_t,1)
            POP AX
            BX = AX
            IF (BX.0 = ')')
               BX++
               AX = BX
               STC
            ELSE
               error_code = NOCLOSEBRACKET_ER
               CLC
            ENDIF
            EXITL
         ENDIF
         IFL (BX.0 = '=')
            ; di points to variable_string
            DI++
            BX++
            REPEAT
               EXIT (BX.0 = 0 || BX.0 = QUOTE)
               BX++
            ENDREP
            PUSH DI
            CX = 0
            DX = 0
            REPEAT
               AL = BX.0
               EXIT (AL = 0)
               BX++
               IF (DL = 1 && AL = QUOTE)
                  CH++
                  EXIT
               ENDIF
               IF (AL = BACKSLASH)
                  IF (DL = 1)
                     DI.0 = ','
                     DI++
                     CL++
                     CH++
                     CONTINUE
                  ENDIF
                  DI.0 = QUOTE
                  DI.1 = ','
                  DI += 2
                  DL = 1
                  CL += 2
                  CH++
                  CONTINUE
               ENDIF
               IF (DL = 1 && AL = SPACE)
                  DI.0 = ','
                  DI.1 = QUOTE
                  DI += 2
                  DL = 0
                  CL += 2
                  CONTINUE
               ENDIF
               DI.0 = AL
               DI++
               CL++
               IF (DL <> 1)
                  CH++
               ENDIF
            ENDREP
            POP DI
            BX--
            DI--
            DI.0 = CL
            AL = CH
            AH = 0
            AL -= 2
            SI = &number_string
            SI.0 = 6
            numasc(SI,AX)
            writeobject2(SI,&comma_t,0)
            writeobject1(DI,0)
            writechar(',',0)
            writechar('0',1)
            IF (BX.0 = QUOTE)
               BX++
               AX = BX
               STC
            ELSE
               error_code = NOCLOSEQUOTE_ER
               CLC
            ENDIF
            EXIT
         ENDIF
         error_code = INVALIDMESSAGE_ER
         CLC
      END
   ELSE
      CLC
   ENDIF
END
POP DI
POP BX
}
;-----------------------------
list_p (list_aD)
WORD
{
PUSH BX
PUSH CX
PUSH DI
DO
   AL = status
   IFL (AL = DECLAREDATA || AL = STATUS_EXTERNDEF || withinproc = 1)
      DO
         BX = list_aD
         removewhitespace(BX)
         BX = AX
         DI = &variable_string
         PUSH DI
         DI++
         DI.0 = GLOBAL_LIST
         DI += 2
         d3strcpy(BX,DI,' ','(','=')
         DI--
         DI.0 = AL
         BX += AX
         POP DI
         AL += 4
         DI.0 = AL
         storeglobal(DI)
         EXITL (NC)
         DI += 2
         IF (status = STATUS_EXTERNDEF)
            writeobject2(&extrn_t,DI,0)
            writechar(':',0)
            writeobject1(&byte_t,1)
            AX = BX
            STC
            EXITL
         ENDIF
         IF (makeallpublic = 1)
            writeobject2(&public_t,DI,1)
         ENDIF
         writeobject2(DI,&db_t,0)
         removewhitespace(BX)
         BX = AX
         IF (BX.0 = '(')
            ; which is test1 DB 10 DUP (0)
            BX++
            removewhitespace(BX)
            BX = AX
            AL = BX.0
            IF (AL >= '0' && AL <= '9')
               writenumber(BX,0)
               BX = AX
            ELSE
               SI = &number_string
               SI++
               dstrcpy(BX,SI,')')
               SI--
               SI.0 = AL
               BX += AX
               writeobject1(SI,0)
            ENDIF
            writechar(' ',0)
            writeobject1(&dupzero_t,1)
            IF (BX.0 = ')')
               BX++
               AX = BX
               STC
            ELSE
               error_code = NOCLOSEQUOTE_ER
               CLC
            ENDIF
            EXITL
         ENDIF
         IFL (BX.0 = '=')
            ; di points to variable_string (len)
            DI = &variable_string
            PUSH DI
            DI++
            BX++
            removewhitespace(BX)
            BX = AX
            REPEAT
               AL = BX.0
               BX++
               EXIT (AL = 0)
               DI.0 = AL
               DI++
               CL++
            ENDREP
            DI.0 = 0
            POP DI
            DI.0 = CL
            writeobject1(DI,1)
            AX = BX
            STC
            EXIT
         ENDIF
         error_code = INVALIDLIST_ER
         CLC
         EXIT
      END
      EXITL
   ENDIF
   IFL (AL = STATUS_LOCAL)
      DO
         BX = list_aD
         removewhitespace(BX)
         BX = AX
         DI = &variable_string
         DI++
         DI.0 = LOCAL_LIST
         DI += 2
         d2strcpy(BX,DI,' ','(')
         DI--
         DI.0 = AL
         BX += AX
         DI += AX + 2
         CX = AX
         removewhitespace(BX)
         BX = AX
         IF (BX.0 <> '(')
            error_code = INVALIDLIST_ER
            CLC
            EXIT
         ENDIF
         BX++
         SI = &number_string
         dstrcpy(BX,SI,')')
         BX += AX
         IF (BX.0 <> ')')
            error_code = NOCLOSEBRACKET_ER
            CLC
            EXIT
         ENDIF
         SI = &newlocid
         DI.0 = SI.3
         DI.1 = SI.4
         DI.2 = SI.5
         DI = &variable_string
         CL += 7
         DI.0 = CL
         storelocal(DI)
         EXIT (NC)
         localcount++
         update_local(LOCAL_LIST)
         AX = BX
         STC
      END
      EXIT
   ENDIF
   IF (AL = STATUS_STRUCTMEM)
      translate_structmem(list_aD,2)
      EXIT
   ENDIF
   CLC
END
POP DI
POP CX
POP BX
}
;-----------------------------
array_p (array_aD)
WORD
{
; Syntax of ARRAY macro is as follows
; ARRAY NAME [NN] OF TYPE
;  where type is optional (defaul BYTE)
;  where nn is array value
; Eg. ARRAY name [10] -> name DB 10 DUP (0)
;   accessed by  AL = name[0]  ->  MOV AL,BYTE PTR [name+0]
;    where the index wil be 0..9
PUSH BX
PUSH SI
PUSH DI
DO
   AL = status
   IFL (AL = DECLAREDATA || AL = STATUS_EXTERNDEF || withinproc = 1)
      DO
         BX = array_aD
         removewhitespace(BX)
         BX = AX
         ; pointing at the name
         DI = &variable_string
         DI++
         DI.0 = GLOBAL_ARRAY
         DI++
         SI = DI
         DI++
         XOR CX,CX
         REPEAT
            AL = BX.0
            iswhite()
            EXIT (C)
            EXIT (AL = 0 || AL = '[')
            DI.0 = AL
            BX++
            DI++
            CX++
         ENDREP
         removewhitespace(BX)
         BX = AX
         AL = BX.0
         IF (AL <> '[')
            error_code = INVALIDARRAY_ER
            CLC
            EXITL
         ENDIF
         SI.0 = CL
         DI.0 = 0
         DI++
         IF (makeallpublic = 1)
            writeobject2(&public_t,SI,1)
         ENDIF
         writeobject2(SI,&db_t,0)
         ; name [nn][mm] -> DB (nn)*(mm)
         PUSH DI ; position for number of dims
         DI++
         XOR CX,CX
         REPEAT
            removewhitespace(BX)
            BX = AX
            EXITL (BX.0 <> '[')
            BX++
            removewhitespace(BX)
            BX = AX
            writechar('(',0)
            AL = BX.0
            ;
            SI = &number_string
            SI++
            dstrcpy(BX,SI,']')
            SI--
            SI.0 = AL
            BX += AX
            writeobject1(SI,0)
            SI++
            strcpy(SI,DI)
            DI += AX + 1
            ;
            writechar(')',0)
            REPEAT
               EXIT (BX.0 = ']' || BX.0 = 0)
               BX++
            ENDREP
            EXIT (BX.0 = 0)
            BX++
            removewhitespace(BX)
            BX = AX
            CX++
            EXIT (BX.0 <> '[')
            writechar('*',0)
         ENDREPL
         ; set number of dims
         POP SI
         SI.0 = CL
         ; exit with BX at null if ok
         ; or at '=' if initialise
         DO
            IF (BX.0 = 0)
               STC
               EXITL
            ENDIF
            IF (BX.0 = '=')
               ; ???
               STC
               EXITL
            ENDIF
            ; test for OF TYPE
            SI = &number_string
            dstrcpy(BX,SI,' ')
            BX += AX
            AX = &of_t
            AX++
            strcmp(SI,AX)
            IF (NC)
               error_code = INVALIDOF_ER
               CLC
               EXIT
            ENDIF
            removewhitespace(BX)
            BX = AX ; at type
            SI++
            strcpy(BX,SI)
            IF (AL = 0)
               error_code = INVALIDOF_ER
               CLC
               EXIT
            ENDIF
            SI--
            SI.0 = AL
            writechar('*',0)
            writechar('(',0)
            writeobject1(SI,0)
            writechar(')',0)
            SI++
            strcpy(SI,DI)
            DI += AX + 1
            STC
         END
         EXITL (NC)
         writechar(' ',0)
         writeobject1(&dupzero_t,1)
         ; store the type
         AX = &variable_string
         CX = DI - AX
         DI = AX
         DI.0 = CL
         storeglobal(DI)
         EXIT (NC)
;         IFL (BX.0 = '=')
;            ; di points to variable_string (len)
;            DI = &variable_string
;            PUSH DI
;            DI++
;            BX++
;            removewhitespace(BX)
;            BX = AX
;            REPEAT
;               AL = BX.0
;               BX++
;               EXIT (AL = 0)
;               DI.0 = AL
;               DI++
;               CL++
;            ENDREP
;            DI.0 = 0
;            POP DI
;            DI.0 = CL
;            writeobject1(DI,1)
;            AX = BX
;            STC
;            EXIT
;         ENDIF
         STC
      END
      EXITL
   ENDIF
   IF (AL = STATUS_STRUCTMEM)
      translate_structmem(array_aD,2)
      EXIT
   ENDIF
   CLC
END
POP DI
POP SI
POP BX
}
;-----------------------------
far_p (far_aD)
WORD
{
PUSH BX
PUSH DI
DO
   IF (status = STATUS_EXTERNDEF)
      BX = far_aD
      removewhitespace(BX)
      BX = AX
      storeexternalprocdef(BX,1)
      EXIT
   ENDIF
   CLC
END
POP DI
POP BX
}
